DEBUG=True
DEMO_MODE=false
TIME_ZONE=UTC
# Generate a unique key locally: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=
TRUST_PROXY_SSL=false
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
DB_ENGINE=sqlite
SQLITE_PATH=./db.sqlite3
# Docker Compose runs PostgreSQL; these values are local-only examples.
POSTGRES_DB=riva_local
POSTGRES_USER=riva
POSTGRES_PASSWORD=replace-with-a-unique-local-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
RIVA_BIND_PORT=8011
RIVA_POSTGRES_BIND_PORT=5433
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=shop_catalog
SHOP_CURRENCY=USDT
TOMAN_PER_USD=265900
FX_RATE_MAX_AGE_HOURS=24
PAYMENT_PROVIDER=mock
ALLOW_MOCK_PAYMENTS=true
ALLOW_UNAUDITED_FX_FALLBACK=true
STRIPE_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_GATEWAY_TIMEOUT_SECONDS=15
PAYMENT_RESERVATION_MINUTES=30
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300
PUBLIC_SITE_URL=
BACKUP_DIR=backups
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=riva/database
BACKUP_S3_REGION=us-east-1
BACKUP_S3_KMS_KEY_ID=
BACKUP_S3_ENDPOINT_URL=
BACKUP_RESTORE_TEST_ENABLED=true
DATABASE_BACKUP_ENABLED=true
DATABASE_BACKUP_HOUR=2
DATABASE_BACKUP_MINUTE=0
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=Riva Support <support@example.com>
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=1536
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
ADMIN_DAILY_REPORT_ENABLED=true
ADMIN_REPORT_HOUR=9
ADMIN_REPORT_MINUTE=0
# Optional image namespace used by docker compose build/push.
DOCKERHUB_NAMESPACE=local
IMAGE_TAG=latest
# Optional provider endpoint contract: JSON {"rate": "TOMAN per USD", "observed_at": "ISO-8601", "source": "provider"}.
FX_RATE_PROVIDER_URL=
FX_RATE_PROVIDER_TOKEN=
FX_RATE_PROVIDER_SOURCE=
